                return `🤖 **المساعد:** أفهم أنك تطلب: "${promrompt}"\n\n` +
                       `أقترح كتابة الكود التالي في لغة ${currentLanguage}:\n\n` +
                       `\`\`\`${currentLanguage}\n// كود ${currentLanguage} لمتطلباتك\nfunction solution() {\n  // اكتب منطق الحل هنا\n  console.log("مرحباً بالعالم!");\n}\n\`\`\`\n\n` +
                       `💡 **نصيحة:** يمكنك استخدام أزرار التحكم في المحرر لتوليد كود أوثق بمتطلباتك.`;
            }
        }
        
        // ========== محرر الأكواد ==========
        function changeLanguage(lang) {
            currentLanguage = lang;
            
            // تحديث أزرار اللغة
            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');
            
            // تحديث المحرر
            if (editor) {
                const model = editor.getModel();
                monaco.editor.setModelLanguage(model, lang);
            }
            
            document.getElementById('current-language').textContent = 
                lang === 'javascript' ? 'JavaScript' :
                lang === 'python' ? 'Python' :
                lang === 'html' ? 'HTML' :
                lang === 'css' ? 'CSS' :
                lang === 'java' ? 'Java' :
                lang === 'cpp' ? 'C++' :
                lang === 'php' ? 'PHP' : lang;
            
            showNotification(`تم تغيير لغة البرمجة إلى ${lang}`, 'info');
        }
        
        function updateCodeStats() {
            if (!editor) return;
            
            const code = editor.getValue();
            linesOfCode = code.split('\n').length;
            document.getElementById('lines-of-code').textContent = linesOfCode;
            
            // اكتشاف الأخطاء البسيطة (محاكاة)
            const errors = detectSimpleErrors(code, currentLanguage);
            errorsFound = errors.length;
            document.getElementById('errors-found').textContent = errorsFound;
            
            if (errorsFound > 0) {
                showNotification(`تم اكتشاف ${errorsFound} خطأ في الكود`, 'warning', 2000);
            }
        }
        
        function detectSimpleErrors(code, language) {
            const errors = [];
            
            if (language === 'javascript') {
                // اكتشاف أخطاء JavaScript شائعة
                if (code.includes('console.log') && !code.includes('console')) {
                    errors.push('قد تحتاج إلى تعريف console');
                }
                if (code.match(/function\s+\w+\s*\(/g) && !code.includes('return') && code.includes('function')) {
                    errors.push('دالة بدون return قد لا تعمل كما هو متوقع');
                }
            }
            
            if (language === 'python') {
                // اكتشاف أخطاء Python شائعة
                if (code.includes('print') && code.includes('Python 3')) {
                    // لا شيء
                }
                if (code.includes('import') && !code.includes('from')) {
                    const imports = code.match(/import\s+(\w+)/g);
                    if (imports) {
                        imports.forEach(imp => {
                            if (!code.includes(imp.split(' ')[1])) {
                                errors.push(`المكتبة ${imp} مستوردة لكن غير مستخدمة`);
                            }
                        });
                    }
                }
            }
            
            return errors;
        }
        
        function runCode() {
            const code = editor.getValue();
            const output = document.getElementById('output-container');
            
            output.innerHTML = '<div class="output-warning">▶ جاري تنفيذ الكود...</div>';
            
            try {
                let result;
                
                switch(currentLanguage) {
                    case 'javascript':
                        result = executeJavaScript(code);
                        break;
                    case 'python':
                        result = executePython(code);
                        break;
                    case 'html':
                        result = executeHTML(code);
                        break;
                    default:
                        result = { output: 'تنفيذ هذه اللغة غير مدعوم مباشرة في المتصفح', error: null };
                }
                
                if (result.error) {
                    output.innerHTML = `<div class="output-error">❌ خطأ في التنفيذ:\n${result.error}</div>`;
                    errorsFound++;
                } else {
                    output.innerHTML = `<div class="output-success">✅ تم التنفيذ بنجاح:\n${result.output}</div>`;
                }
                
            } catch (error) {
                output.innerHTML = `<div class="output-error">❌ خطأ غير متوقع:\n${error.message}</div>`;
                errorsFound++;
            }
            
            updateCodeStats();
        }
        
        function executeJavaScript(code) {
            try {
                // التقاط console.log
                let output = '';
                const originalLog = console.log;
                console.log = function(...args) {
                    output += args.join(' ') + '\n';
                    originalLog.apply(console, args);
                };
                
                // تنفيذ الكود
                eval(code);
                
                // إعادة console.log الأصلي
                console.log = originalLog;
                
                return { output: output || 'تم التنفيذ بدون إخراج', error: null };
            } catch (error) {
                return { output: null, error: error.message };
            }
        }
        
        function executePython(code) {
            // محاكاة تنفيذ Python (في الواقع يحتاج لخادم بايثون)
            try {
                // محاكاة بسيطة لأكواد Python الشائعة
                let output = '';
                
                if (code.includes('print(')) {
                    const prints = code.match(/print\((.*?)\)/g);
                    if (prints) {
                        prints.forEach(p => {
                            const content = p.match(/print\((.*?)\)/)[1];
                            output += eval(content) + '\n';
                        });
                    }
                }
                
                if (code.includes('def ')) {
                    output += 'تم تعريف الدوال بنجاح\n';
                }
                
                return { 
                    output: output || 'ملاحظة: تنفيذ Python الكامل يحتاج لخادم بايثون حقيقي', 
                    error: null 
                };
            } catch (error) {
                return { output: null, error: error.message };
            }
        }
        
        function executeHTML(code) {
            try {
                // فتح نافذة جديدة لعرض HTML
                const newWindow = window.open();
                newWindow.document.write(code);
                newWindow.document.close();
                
                return { 
                    output: 'تم فتح صفحة HTML في نافذة جديدة', 
                    error: null 
                };
            } catch (error) {
                return { output: null, error: error.message };
            }
        }
        
        function debugCode() {
            const code = editor.getValue();
            const errors = detectSimpleErrors(code, currentLanguage);
            
            const output = document.getElementById('output-container');
            
            if (errors.length === 0) {
                output.innerHTML = '<div class="output-success">✅ لم يتم اكتشاف أخطاء واضحة في الكود.</div>';
            } else {
                let errorList = '🔍 اكتشفت الأخطاء التالية:\n\n';
                errors.forEach((error, index) => {
                    errorList += `${index + 1}. ${error}\n`;
                });
                output.innerHTML = `<div class="output-warning">${errorList}</div>`;
            }
            
            errorsFound = errors.length;
            document.getElementById('errors-found').textContent = errorsFound;
            
            showNotification(`تم اكتشاف ${errors.length} خطأ`, errors.length > 0 ? 'warning' : 'success');
        }
        
        async function generateCode() {
            if (!activeModel) {
                showNotification('يرجى تحميل نموذج أولاً', 'warning');
                return;
            }
            
            const prompt = prompt('أدخل وصف للكود الذي تريده:', `اكتب دالة ${currentLanguage} لـ ...`);
            if (!prompt) return;
            
            showNotification('جاري توليد الكود...', 'info');
            
            try {
                const codePrompt = `// ${prompt}\n// كود ${currentLanguage} كامل\n// مع تعليقات بالعربية\n\n`;
                
                const result = await pipeline(codePrompt, {
                    max_new_tokens: 300,
                    temperature: 0.2,
                    do_sample: true
                });
                
                let generatedCode = result[0].generated_text;
                
                // تنظيف الكود
                generatedCode = generatedCode.replace(/```[\w]*\n?/, '').replace(/\n```$/, '');
                
                // إضافة الكود للمحرر
                insertCodeToEditor(generatedCode);
                
                showNotification('تم توليد الكود بنجاح!', 'success');
                
            } catch (error) {
                showNotification('فشل في توليد الكود: ' + error.message, 'error');
            }
        }
        
        function formatCode() {
            if (!editor) return;
            
            const code = editor.getValue();
            let formattedCode = code;
            
            // تنسيق بسيط
            switch(currentLanguage) {
                case 'javascript':
                case 'java':
                case 'cpp':
                    formattedCode = formatJavaScriptLike(code);
                    break;
                case 'python':
                    formattedCode = formatPython(code);
                    break;
                case 'html':
                    formattedCode = formatHTML(code);
                    break;
                case 'css':
                    formattedCode = formatCSS(code);
                    break;
            }
            
            editor.setValue(formattedCode);
            showNotification('تم تنسيق الكود', 'success');
        }
        
        function formatJavaScriptLike(code) {
            // تنسيق بسيط للغات المشابهة لـ JavaScript
            return code
                .replace(/\{/g, ' {\n')
                .replace(/\}/g, '\n}\n')
                .replace(/;/g, ';\n')
                .replace(/\n\s*\n/g, '\n');
        }
        
        function insertCodeToEditor(code) {
            if (!editor) return;
            
            const currentPosition = editor.getPosition();
            editor.executeEdits("", [{
                range: new monaco.Range(
                    currentPosition.lineNumber,
                    currentPosition.column,
                    currentPosition.lineNumber,
                    currentPosition.column
                ),
                text: '\n' + code + '\n'
            }]);
        }
        
        function clearCodeEditor() {
            if (confirm('هل تريد مسح جميع الأكواد من المحرر؟')) {
                editor.setValue('// اكتب كودك هنا...\nconsole.log("مرحباً بالعالم!");');
                showNotification('تم مسح المحرر', 'info');
            }
        }
        
        function loadTemplate(templateName) {
            const template = CODE_TEMPLATES[templateName];
            if (template) {
                editor.setValue(template.code);
                changeLanguage(template.language);
                showNotification(`تم تحميل قالب ${templateName}`, 'success');
            }
        }
        
        // ========== إدارة المشاريع ==========
        function saveProject() {
            const projectName = prompt('أدخل اسم المشروع:', `مشروع_${new Date().toISOString().slice(0, 10)}`);
            if (!projectName) return;
            
            const project = {
                name: projectName,
                code: editor.getValue(),
                language: currentLanguage,
                savedAt: new Date().toISOString(),
                lines: linesOfCode
            };
            
            savedProjects[projectName] = project;
            
            try {
                localStorage.setItem('code_projects', JSON.stringify(savedProjects));
                showNotification(`تم حفظ المشروع "${projectName}"`, 'success');
            } catch (e) {
                showNotification('فشل في حفظ المشروع: ' + e.message, 'error');
            }
        }
        
        function loadSavedProjects() {
            try {
                const saved = localStorage.getItem('code_projects');
                if (saved) {
                    savedProjects = JSON.parse(saved);
                    console.log('تم تحميل المشاريع:', Object.keys(savedProjects).length);
                }
            } catch (e) {
                console.error('خطأ في تحميل المشاريع:', e);
            }
        }
        
        function saveModelState() {
            try {
                const modelState = {
                    modelType: selectedModelType,
                    lastUsed: new Date().toISOString(),
                    projectsCount: Object.keys(savedProjects).length
                };
                localStorage.setItem('code_model_state', JSON.stringify(modelState));
            } catch (e) {
                console.error('خطأ في حفظ حالة النموذج:', e);
            }
        }
        
        // ========== وظائف المساعدة ==========
        function addMessage(text, sender, inferenceTime = null) {
            const messagesDiv = document.getElementById('chat-messages');
            const messageDiv = document.createElement('div');
            
            messageDiv.className = `message ${sender}-message`;
            
            let messageHTML = `<strong>${sender === 'user' ? 'أنت' : '🤖 المساعد'}:</strong> ${escapeHtml(text)}`;
            
            if (inferenceTime && sender === 'ai') {
                const model = CODE_MODELS[selectedModelType];
                messageHTML += `<div class="token-info">⏱ ${Math.round(inferenceTime)}ms | ${model.name}</div>`;
            }
            
            messageDiv.innerHTML = messageHTML;
            messagesDiv.appendChild(messageDiv);
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
        }
        
        function addSystemMessage(text) {
            const messagesDiv = document.getElementById('chat-messages');
            const messageDiv = document.createElement('div');
            
            messageDiv.className = 'message ai-message';
            messageDiv.style.background = 'rgba(76, 201, 240, 0.1)';
            messageDiv.innerHTML = `<strong><i class="fas fa-info-circle"></i> النظام:</strong> ${escapeHtml(text)}`;
            
            messagesDiv.appendChild(messageDiv);
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
        }
        
        function showTypingIndicator() {
            const messagesDiv = document.getElementById('chat-messages');
            const indicator = document.createElement('div');
            indicator.id = 'typing-indicator';
            indicator.className = 'typing-indicator';
            indicator.innerHTML = 'المساعد يكتب الكود <span>.</span><span>.</span><span>.</span>';
            
            messagesDiv.appendChild(indicator);
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
        }
        
        function removeTypingIndicator() {
            const indicator = document.getElementById('typing-indicator');
            if (indicator) indicator.remove();
        }
        
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML.replace(/\n/g, '<br>');
        }
        
        function updateSystemInfo() {
            // محاكاة استخدام الموارد
            const memoryUsage = 100 + (linesOfCode * 0.1) + (activeModel ? 200 : 0);
            document.getElementById('memory-usage').textContent = `${memoryUsage.toFixed(1)} MB`;
            
            const cpuUsage = 5 + Math.random() * 15 + (isGenerating ? 20 : 0);
            document.getElementById('cpu-usage').textContent = `${cpuUsage.toFixed(0)}%`;
        }
        
        function showNotification(message, type = 'info', duration = 3000) {
            // إزالة أي إشعارات سابقة
            document.querySelectorAll('.notification').forEach(n => n.remove());
            
            const notification = document.createElement('div');
            notification.className = 'notification';
            
            const iconMap = {
                success: 'check-circle',
                error: 'exclamation-circle',
                warning: 'exclamation-triangle',
                info: 'info-circle'
            };
            
            notification.innerHTML = `
                <i class="fas fa-${iconMap[type] || 'info-circle'}" style="color: ${
                    type === 'success' ? 'var(--success)' : 
                    type === 'error' ? 'var(--error)' : 
                    type === 'warning' ? 'var(--warning)' : 'var(--primary)'
                }"></i>
                <span>${message}</span>
            `;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.style.opacity = '0';
                notification.style.transform = 'translateX(100%)';
                setTimeout(() => notification.remove(), 300);
            }, duration);
        }
        
        // تهيئة textarea
        document.getElementById('message-input').addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && e.ctrlKey) {
                e.preventDefault();
                sendMessage();
            }
            
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 120) + 'px';
        });
    </script>
