# المؤلف: مساعد الذكاء الاصطناعي

def calculate_statistics(numbers):
    """
    حساب الإحصائيات الأساسية لقائمة من الأرقام
    """
    if not numbers:
        return None
    
    stats = {
        'المجموع': sum(numbers),
        'المتوسط': sum(numbers) / len(numbers),
        'العدد': len(numbers),
        'الأصغر': min(numbers),
        'الأكبر': max(numbers)
    }
    
    # حساب الوسيط
    sorted_numbers = sorted(numbers)
    n = len(sorted_numbers)
    if n % 2 == 0:
        stats['الوسيط'] = (sorted_numbers[n//2 - 1] + sorted_numbers[n//2]) / 2
    else:
        stats['الوسيط'] = sorted_numbers[n//2]
    
    return stats

def fibonacci_sequence(n):
    """
    إنشاء متتالية فيبوناتشي حتى الحد النوني
    """
    sequence = [0, 1]
    for i in range(2, n):
        sequence.append(sequence[-1] + sequence[-2])
    return sequence[:n]

def is_prime(num):
    """
    التحقق إذا كان الرقم أولياً
    """
    if num < 2:
        return False
    for i in range(2, int(num ** 0.5) + 1):
        if num % i == 0:
            return False
    return True

